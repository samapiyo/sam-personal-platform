# Local development only. Never commit your real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///site.db
API_KEY=replace-with-your-api-key
MPESA_CONSUMER_KEY=replace-with-your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=replace-with-your-mpesa-consumer-secret

# Set to 1 only when HTTPS is enabled (Render production).
SESSION_COOKIE_SECURE=0

# M-Pesa / Safaricom Daraja
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
